# Production environment configuration for MLForge
# Copy this file to .env.prod on the VPS and configure real secrets.
# NEVER commit .env.prod to source control.

# Set to "production" (disables local dev auth bypass)
MLFORGE_ENV=production

# Shared API key for service-account bypass and admin operations
# Generate a secure key, e.g. with: openssl rand -hex 32
MLFORGE_API_KEY=changeme-generate-a-strong-random-api-key

# CORS allowed origins (exact frontend URL in production, without trailing slash)
MLFORGE_CORS_ORIGINS=https://mlforge.adityajagtap.com

# Loopback host ports bound on the VPS (only accessible via localhost / Nginx)
HOST_PORT_API=8050
HOST_PORT_WEB=8051
